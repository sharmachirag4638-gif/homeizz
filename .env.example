# Copy this file to .env.local for local dev, and add the same values to
# Vercel → Project → Settings → Environment Variables for production.

# ==== Supabase ====
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-side only. Keep SECRET. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ==== Razorpay ====
# https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Razorpay subscription plan IDs.
# Create these six Plans in Razorpay first, then paste their plan_ IDs here.
RAZORPAY_PLAN_STARTER_MONTHLY=plan_XXXXXXXXXXXX
RAZORPAY_PLAN_STARTER_ANNUAL=plan_XXXXXXXXXXXX
RAZORPAY_PLAN_GROWTH_MONTHLY=plan_XXXXXXXXXXXX
RAZORPAY_PLAN_GROWTH_ANNUAL=plan_XXXXXXXXXXXX
RAZORPAY_PLAN_PRO_MONTHLY=plan_XXXXXXXXXXXX
RAZORPAY_PLAN_PRO_ANNUAL=plan_XXXXXXXXXXXX

# ==== Resend (transactional email) ====
# https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXX
RESEND_FROM_EMAIL=hello@homeizz.in

# ==== Site ====
NEXT_PUBLIC_SITE_URL=https://homeizz.in

# ==== Google Analytics 4 (optional, leave blank locally) ====
# Get from analytics.google.com -> Admin -> Data Streams -> click stream -> Measurement ID
NEXT_PUBLIC_GA_ID=

# ==== Google Search Console (optional) ====
# Paste only the content="..." value from the verification meta tag
GOOGLE_SITE_VERIFICATION=
